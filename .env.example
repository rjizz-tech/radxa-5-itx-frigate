# Copy to .env on the board and chmod 600 .env. Do not commit secrets.
FRIGATE_IMAGE=radxa-frigate:0.18.0-radxa.1
CONFIG_DIR=/srv/frigate/config
MEDIA_DIR=/srv/frigate/media
# Existing SATA filesystem UUID, used by preflight/start. Never a /dev/sdX name.
MEDIA_UUID=REPLACE_WITH_EXISTING_SATA_FILESYSTEM_UUID
BIND_IP=0.0.0.0
FRIGATE_MQTT_HOST=REPLACE_WITH_HOME_ASSISTANT_BROKER
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_USER=REPLACE_WITH_MQTT_USER
FRIGATE_MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD
FRIGATE_MQTT_TLS=false
FRIGATE_RTSP_HOST=REPLACE_WITH_WYZE_ADDRESS
FRIGATE_RTSP_USER=viewer
FRIGATE_RTSP_PASSWORD=REPLACE_WITH_CAMERA_PASSWORD
FRIGATE_RESTREAM_PASSWORD=REPLACE_WITH_RESTREAM_PASSWORD
